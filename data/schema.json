{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awesome Compute Access catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "programs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "provider",
          "benefit",
          "eligibility",
          "region",
          "application",
          "limits",
          "cost_risks",
          "status",
          "verification",
          "verified_on",
          "notes",
          "categories",
          "resource_types",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "eligibility": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "application": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "string",
            "minLength": 1
          },
          "cost_risks": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "active",
              "application_required",
              "paused",
              "closed",
              "unverified"
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "official_page",
              "official_link_only",
              "readme_lead"
            ]
          },
          "verified_on": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "notes": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "free-compute",
                "low-cost",
                "education",
                "research",
                "startup",
                "open-source",
                "nonprofit",
                "china-policy",
                "api"
              ]
            }
          },
          "resource_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "active",
                    "application_required"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "verification": {
                  "const": "official_page"
                }
              }
            }
          }
        ]
      }
    }
  }
}
